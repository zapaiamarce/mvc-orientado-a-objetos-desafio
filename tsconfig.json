{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "noUnusedLocals": false,
    "module": "commonjs",
    "outDir": "build",
    "resolveJsonModule": true,
    "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "target": "es2015",
    "lib": ["es2015", "dom"]
  }
}
