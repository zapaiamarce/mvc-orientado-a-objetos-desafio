{
  "extends": "@sindresorhus/tsconfig",
  "compilerOptions": {
    "noUnusedLocals": false,
    "module": "commonjs",
    "outDir": "build",
    "resolveJsonModule": true,
    "noUnusedParameters": false,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false,
    "strict": true, // Esto habilita todas las verificaciones estrictas
        "strictPropertyInitialization": true // Asegúrate de que esto esté configurado
  }
}
